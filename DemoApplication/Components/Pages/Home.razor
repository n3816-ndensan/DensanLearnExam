@page "/"
@rendermode InteractiveServer
@inherits HomeModel

<PageTitle>EmployeeList</PageTitle>

<h1>社員一覧</h1>

<RadzenButton Text="社員を追加" class="btn btn-primary" Click="NavigateToEmployeeFormAsync"></RadzenButton>

<RadzenDataGrid TItem="EmployeeItem" Style="width: 738px" Data="@EmployeeList" AllowColumnResize="true">
    <Columns>
        <RadzenDataGridColumn TItem="EmployeeItem" Property="Name" Title="氏名"></RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EmployeeItem" Property="HireDate" Title="入社日" FormatString="{0:yyyy/MM/dd}"></RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EmployeeItem" Property="EmploymentType" Title="雇用形態"></RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EmployeeItem" Title="備考">
            <Template Context="employee">
            @employee.Remarks.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

