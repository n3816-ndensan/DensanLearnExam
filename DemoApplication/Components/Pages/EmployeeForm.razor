@page "/employeeForm"
@rendermode InteractiveServer
@inherits EmployeeFormModel

<h1>社員登録</h1>

<EditForm Model="@newEmployee" OnValidSubmit="HandleValidSubmitAsync">
    <DataAnnotationsValidator />
    <div>
        <RadzenLabel Text="氏名" />
        <RadzenTextBox @bind-Value="@newEmployee.Name" Style="width: 225px"></RadzenTextBox>
        <ValidationMessage For="@(() => newEmployee.Name)" />
    </div>
    <div>
        <RadzenLabel Text="入社日" />
        <RadzenDatePicker TValue="DateTime" @bind-Value="@newEmployee.HireDate" DateFormat="yyyy/MM/dd" Style="width: 124px" ></RadzenDatePicker>
        <ValidationMessage For="@(() => newEmployee.HireDate)" />
    </div>
    <div>
        <RadzenLabel Text="雇用形態" />
        <RadzenDropDown TValue="EmploymentTypes" @bind-Value="@newEmployee.EmploymentType" Data="Enum.GetValues(typeof(EmploymentTypes))" Style="width: 124px"></RadzenDropDown>
        <ValidationMessage For="@(() => newEmployee.EmploymentType)" />
    </div>
    <div>
        <RadzenLabel Text="備考" Style="float: left" />
        <RadzenTextArea @bind-Value="@newEmployee.Remarks" Style="height: 91px; width: 230px"></RadzenTextArea>
    </div>
    <RadzenButton Text="社員登録" ButtonType="Radzen.ButtonType.Submit"></RadzenButton>
    <RadzenButton Text="Cancel" ButtonType="Radzen.ButtonType.Button" Click="@NavigateToHomeAsync"></RadzenButton>
</EditForm>